{
  "about": "The binary reference corpus (docs/plans/binary.md, stage 2). Each project is built at every optimisation level, in three forms, with an answer key. Paths are relative to the repo root. Build: python3 tests/tools/build_corpus.py --out <dir>. '@repo/' in sources and flags means the repo root; '@bin:NAME' in libs links against a binary built earlier in the same project (stub libraries, tests/corpus/stubs). Projects marked 'sealed' are held-out test data for identification research (docs/notes/2026-11-18-bin-skeletons.md): don't tune anything on them.",
  "opt_levels": [
    "-O0",
    "-O1",
    "-O2",
    "-O3",
    "-Os"
  ],
  "projects": [
    {
      "name": "samples",
      "root": "tests/fixtures/programs/c",
      "binaries": [
        {
          "name": "basic",
          "kind": "exe",
          "sources": [
            "basic/main.c"
          ]
        },
        {
          "name": "multi",
          "kind": "exe",
          "sources": [
            "multi/src/util.c",
            "multi/src/app.c"
          ]
        }
      ]
    },
    {
      "name": "glue",
      "root": "tests/fixtures/programs/c/http_glue",
      "cflags": [
        "-I@repo/tests/corpus/stubs/include"
      ],
      "binaries": [
        {
          "name": "libcurl.so.4",
          "kind": "shared",
          "sources": [
            "@repo/tests/corpus/stubs/curl_stub.c"
          ],
          "libs": [
            "-Wl,-soname,libcurl.so.4"
          ],
          "stub": true
        },
        {
          "name": "libsqlite3.so.0",
          "kind": "shared",
          "sources": [
            "@repo/tests/corpus/stubs/sqlite3_stub.c"
          ],
          "libs": [
            "-Wl,-soname,libsqlite3.so.0"
          ],
          "stub": true
        },
        {
          "name": "http_glue",
          "kind": "exe",
          "sources": [
            "sync.c",
            "@repo/tests/corpus/stubs/glue_main.c"
          ],
          "libs": [
            "@bin:libcurl.so.4",
            "@bin:libsqlite3.so.0",
            "-Wl,-rpath,$ORIGIN"
          ],
          "expected": "expected.json"
        }
      ]
    },
    {
      "name": "zlib",
      "root": "External_Libraries/corpus/zlib",
      "cflags": [
        "-I."
      ],
      "library": [
        "adler32.c",
        "compress.c",
        "crc32.c",
        "deflate.c",
        "gzclose.c",
        "gzlib.c",
        "gzread.c",
        "gzwrite.c",
        "infback.c",
        "inffast.c",
        "inflate.c",
        "inftrees.c",
        "trees.c",
        "uncompr.c",
        "zutil.c"
      ],
      "binaries": [
        {
          "name": "libz.so",
          "kind": "shared",
          "sources": [
            "@library"
          ]
        },
        {
          "name": "minigzip",
          "kind": "exe",
          "sources": [
            "@library",
            "test/minigzip.c"
          ]
        },
        {
          "name": "example",
          "kind": "exe",
          "sources": [
            "@library",
            "test/example.c"
          ]
        }
      ]
    },
    {
      "name": "cJSON",
      "root": "External_Libraries/corpus/cJSON",
      "cflags": [
        "-I."
      ],
      "binaries": [
        {
          "name": "libcjson.so",
          "kind": "shared",
          "sources": [
            "cJSON.c",
            "cJSON_Utils.c"
          ],
          "libs": [
            "-lm"
          ]
        },
        {
          "name": "cjson_test",
          "kind": "exe",
          "sources": [
            "cJSON.c",
            "test.c"
          ],
          "libs": [
            "-lm"
          ]
        }
      ]
    },
    {
      "name": "lz4",
      "root": "External_Libraries/corpus/lz4",
      "sealed": true,
      "cflags": [
        "-Ilib"
      ],
      "library": [
        "lib/lz4.c",
        "lib/lz4hc.c",
        "lib/lz4frame.c",
        "lib/xxhash.c",
        "lib/lz4file.c"
      ],
      "binaries": [
        {
          "name": "liblz4.so",
          "kind": "shared",
          "sources": [
            "@library"
          ]
        },
        {
          "name": "lz4_frame",
          "kind": "exe",
          "sources": [
            "@library",
            "examples/frameCompress.c"
          ]
        },
        {
          "name": "lz4_file",
          "kind": "exe",
          "sources": [
            "@library",
            "examples/fileCompress.c"
          ]
        }
      ]
    },
    {
      "name": "parson",
      "root": "External_Libraries/corpus/parson",
      "sealed": true,
      "cflags": [
        "-I.",
        "-DTESTS_MAIN"
      ],
      "binaries": [
        {
          "name": "libparson.so",
          "kind": "shared",
          "sources": [
            "parson.c"
          ],
          "libs": [
            "-lm"
          ]
        },
        {
          "name": "parson_tests",
          "kind": "exe",
          "sources": [
            "parson.c",
            "tests.c"
          ],
          "libs": [
            "-lm"
          ]
        }
      ]
    },
    {
      "name": "sqlite",
      "optional": "--with-sqlite",
      "download": {
        "url": "https://www.sqlite.org/2026/sqlite-amalgamation-3540100.zip",
        "sha3_256": "92281c86e2957f9b9305890f9ac04204caa7b677cc868dc326d942689df28e30",
        "strip_dir": "sqlite-amalgamation-3540100"
      },
      "cflags": [
        "-I.",
        "-DSQLITE_THREADSAFE=0",
        "-DSQLITE_OMIT_LOAD_EXTENSION"
      ],
      "binaries": [
        {
          "name": "libsqlite3.so",
          "kind": "shared",
          "sources": [
            "sqlite3.c"
          ]
        }
      ]
    }
  ]
}
